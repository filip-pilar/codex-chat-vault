#!/bin/sh

set -eu

[ -n "${ALV_FAKE_RCLONE_STATE:-}" ] || {
  printf 'ALV_FAKE_RCLONE_STATE is required\n' >&2
  exit 2
}

ALV_FAKE_REMOTES=$ALV_FAKE_RCLONE_STATE/remotes
ALV_FAKE_OBJECTS=$ALV_FAKE_RCLONE_STATE/objects
mkdir -p "$ALV_FAKE_REMOTES" "$ALV_FAKE_OBJECTS"

if [ -n "${ALV_FAKE_RCLONE_LOG:-}" ]; then
  ALV_FAKE_FIRST=true
  for ALV_FAKE_ARGUMENT in "$@"; do
    if [ "$ALV_FAKE_FIRST" = true ]; then
      ALV_FAKE_FIRST=false
    else
      printf '\t' >> "$ALV_FAKE_RCLONE_LOG"
    fi
    printf '%s' "$ALV_FAKE_ARGUMENT" >> "$ALV_FAKE_RCLONE_LOG"
  done
  printf '\n' >> "$ALV_FAKE_RCLONE_LOG"
fi

alv_fake_remote_file() {
  ALV_FAKE_REMOTE_NAME=$1
  case "$ALV_FAKE_REMOTE_NAME" in
    ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) exit 2 ;;
  esac
  ALV_FAKE_REMOTE_FILE=$ALV_FAKE_REMOTES/$ALV_FAKE_REMOTE_NAME
}

alv_fake_resolve() {
  ALV_FAKE_INPUT=$1
  case "$ALV_FAKE_INPUT" in
    *:*)
      ALV_FAKE_RESOLVE_REMOTE=${ALV_FAKE_INPUT%%:*}
      ALV_FAKE_RESOLVE_PATH=${ALV_FAKE_INPUT#*:}
      case "$ALV_FAKE_RESOLVE_PATH" in
        /*|*..*) exit 2 ;;
      esac
      ALV_FAKE_RESOLVED=$ALV_FAKE_OBJECTS/$ALV_FAKE_RESOLVE_REMOTE/$ALV_FAKE_RESOLVE_PATH
      ;;
    *) ALV_FAKE_RESOLVED=$ALV_FAKE_INPUT ;;
  esac
}

case "${1:-}" in
  listremotes)
    [ "${ALV_FAKE_RCLONE_FAIL_LIST:-}" != 1 ] || exit 7
    for ALV_FAKE_FILE in "$ALV_FAKE_REMOTES"/*; do
      [ -f "$ALV_FAKE_FILE" ] || continue
      printf '%s:\n' "${ALV_FAKE_FILE##*/}"
    done
    ;;
  config)
    case "${2:-}" in
      create)
        [ "$#" -ge 4 ] || exit 2
        ALV_FAKE_NAME=$3
        ALV_FAKE_TYPE=$4
        alv_fake_remote_file "$ALV_FAKE_NAME"
        [ ! -e "$ALV_FAKE_REMOTE_FILE" ] || exit 1
        printf 'type = %s\n' "$ALV_FAKE_TYPE" > "$ALV_FAKE_REMOTE_FILE"
        ALV_FAKE_NO_OUTPUT=false
        shift 4
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --no-output)
              ALV_FAKE_NO_OUTPUT=true
              shift
              ;;
            --obscure|--all)
              shift
              ;;
            --*)
              shift
              ;;
            *)
              [ "$#" -ge 2 ] || exit 2
              printf '%s = %s\n' "$1" "$2" >> "$ALV_FAKE_REMOTE_FILE"
              shift 2
            ;;
          esac
        done
        case "$ALV_FAKE_TYPE" in
          dropbox)
            printf '%s\n' \
              'token = {"access_token":"fake-dropbox-token"}' >> \
              "$ALV_FAKE_REMOTE_FILE"
            ;;
          onedrive)
            printf '%s\n' \
              'token = {"access_token":"fake-onedrive-token"}' \
              'drive_id = fake-drive-id' \
              "drive_type = ${ALV_FAKE_RCLONE_ONEDRIVE_TYPE:-personal}" >> \
              "$ALV_FAKE_REMOTE_FILE"
            ;;
        esac
        if [ "$ALV_FAKE_NO_OUTPUT" = false ]; then
          sed -n '1,$p' "$ALV_FAKE_REMOTE_FILE"
        fi
        if [ "${ALV_FAKE_RCLONE_FAIL_CREATE_AFTER_WRITE:-}" = \
             "$ALV_FAKE_NAME" ]; then
          exit 8
        fi
        if [ "${ALV_FAKE_RCLONE_INTERRUPT_CREATE:-}" = \
             "$ALV_FAKE_NAME" ]; then
          kill -TERM "$PPID"
          exit 143
        fi
        ;;
      delete)
        [ "$#" -eq 3 ] || exit 2
        alv_fake_remote_file "$3"
        [ -f "$ALV_FAKE_REMOTE_FILE" ] || exit 1
        unlink "$ALV_FAKE_REMOTE_FILE"
        ;;
      redacted)
        [ "$#" -eq 3 ] || exit 2
        alv_fake_remote_file "$3"
        [ -f "$ALV_FAKE_REMOTE_FILE" ] || exit 1
        sed -E \
          -e 's/^(password2?|secret_access_key|key|token) = .*/\1 = XXX/' \
          "$ALV_FAKE_REMOTE_FILE"
        ;;
      dump)
        [ "$#" -eq 2 ] || exit 2
        command -v jq >/dev/null 2>&1 || exit 2
        ALV_FAKE_DUMP='{}'
        for ALV_FAKE_FILE in "$ALV_FAKE_REMOTES"/*; do
          [ -f "$ALV_FAKE_FILE" ] || continue
          ALV_FAKE_NAME=${ALV_FAKE_FILE##*/}
          ALV_FAKE_CONFIG=$(jq -Rn \
            '[inputs | capture("^(?<key>[^ ]+) = (?<value>.*)$") |
              {(.key): .value}] | add // {}' \
            "$ALV_FAKE_FILE") || exit 2
          ALV_FAKE_DUMP=$(printf '%s\n' "$ALV_FAKE_DUMP" | jq \
            --arg name "$ALV_FAKE_NAME" \
            --argjson config "$ALV_FAKE_CONFIG" \
            '. + {($name): $config}') || exit 2
        done
        printf '%s\n' "$ALV_FAKE_DUMP"
        ;;
      show)
        [ "$#" -eq 3 ] || exit 2
        alv_fake_remote_file "$3"
        [ -f "$ALV_FAKE_REMOTE_FILE" ] || exit 1
        printf '[%s]\n' "$3"
        sed -E \
          -e 's/^(password2?|secret_access_key|key|token) = .*/\1 = obscured-test-value/' \
          "$ALV_FAKE_REMOTE_FILE"
        ;;
      *) exit 2 ;;
    esac
    ;;
  copyto)
    [ "$#" -ge 3 ] || exit 2
    if [ "${ALV_FAKE_RCLONE_FAIL_PROBE:-}" = 1 ]; then
      exit 9
    fi
    alv_fake_resolve "$2"
    ALV_FAKE_SOURCE=$ALV_FAKE_RESOLVED
    alv_fake_resolve "$3"
    ALV_FAKE_DESTINATION=$ALV_FAKE_RESOLVED
    mkdir -p "${ALV_FAKE_DESTINATION%/*}"
    cp "$ALV_FAKE_SOURCE" "$ALV_FAKE_DESTINATION"
    ;;
  deletefile)
    [ "$#" -ge 2 ] || exit 2
    alv_fake_resolve "$2"
    [ -f "$ALV_FAKE_RESOLVED" ] || exit 1
    unlink "$ALV_FAKE_RESOLVED"
    ;;
  *) exit 2 ;;
esac
