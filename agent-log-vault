#!/bin/sh

# shellcheck disable=SC1091

set -eu

umask 077

ALV_PROGRAM=${ALV_INVOKED_AS:-${0##*/}}
ALV_TEMP_DATA=

alv_cleanup() {
  if [ -n "${ALV_TEMP_DATA:-}" ] && [ -e "$ALV_TEMP_DATA" ]; then
    unlink "$ALV_TEMP_DATA" 2>/dev/null || true
    ALV_TEMP_DATA=
  fi
  if command -v alv_vault_setup_cleanup >/dev/null 2>&1; then
    alv_vault_setup_cleanup
  fi
  if command -v alv_profiles_cleanup >/dev/null 2>&1; then
    alv_profiles_cleanup
  fi
  if command -v alv_rclone_storage_cleanup >/dev/null 2>&1; then
    alv_rclone_storage_cleanup
  fi
  if command -v alv_catalog_cleanup >/dev/null 2>&1; then
    alv_catalog_cleanup
  fi
}

alv_fail() {
  printf '%s: %s\n' "$ALV_PROGRAM" "$*" >&2
  alv_cleanup
  exit 1
}

alv_usage() {
  cat <<EOF
Usage:
  $ALV_PROGRAM list local [filters] [--codex-home <directory>]
  $ALV_PROGRAM list cold [--vault <name>]
  $ALV_PROGRAM offload <thread> [--vault <name>] [--codex-home <directory>]
  $ALV_PROGRAM restore <thread> [--vault <name>] [--codex-home <directory>]
  $ALV_PROGRAM verify <thread> [--vault <name>] [--codex-home <directory>]
  $ALV_PROGRAM inspect <chat-or-path> [--codex-home <directory>]
  $ALV_PROGRAM vault list
  $ALV_PROGRAM vault use <name>
  $ALV_PROGRAM vault recovery <name> --output <file>
  $ALV_PROGRAM vault add local <name> --path <absolute-directory>
  $ALV_PROGRAM vault add r2 <name> [options]
  $ALV_PROGRAM vault add b2 <name> [options]
  $ALV_PROGRAM vault add dropbox <name>
  $ALV_PROGRAM vault add onedrive <name>
  $ALV_PROGRAM vault add rclone <name> --remote <existing-target>

Commands:
  list      List chats in local Codex archives or the encrypted cold vault.
  offload   Verify a cold copy, then remove the local archived copy.
  restore   Restore a verified cold copy while retaining it in the vault.
  verify    Read back and verify the encrypted cold copy.
  inspect   Show safe identifying metadata for one Codex archived chat.
  vault     Add, select, list, or export recovery data for named vaults.

The first added vault is the default. Use --vault to select another vault for
one command. Cold storage is always an rclone crypt remote.

Local list filters:
  --long                    Show creation time, bytes, cwd, and filename.
  --created-before <date>   Created before YYYY-MM-DD.
  --created-after <date>    Created after YYYY-MM-DD.
  --project <cwd-or-name>   Exact cwd or final directory name.
  --larger-than <size>      Size in bytes or with K, M, G, or T suffix.

Provider setup options:
  r2  --account-id <id> --access-key-id <id> --secret-access-key <key>
      --bucket <name> [--endpoint <https-url>]
  b2  --key-id <id> --application-key <key> --bucket <name>
      [--endpoint <https-url>]
  Omit provider values to be prompted privately. Do not put secrets in shell
  history or agent-visible command logs.

State locations:
  Codex home    CODEX_HOME or ~/.codex
  ALV profiles  ALV_CONFIG_HOME, XDG_CONFIG_HOME/agent-log-vault, or
                ~/.config/agent-log-vault
  Secrets       rclone's own configuration
EOF
}

alv_exit_cleanup() {
  ALV_EXIT_STATUS=$?
  trap - 0
  alv_cleanup
  exit "$ALV_EXIT_STATUS"
}

trap alv_exit_cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

alv_canonical_directory() {
  [ -d "$1" ] || alv_fail "directory does not exist: $1"
  (CDPATH='' cd -P "$1" 2>/dev/null && pwd -P) || \
    alv_fail "cannot resolve directory: $1"
}

alv_canonical_file() {
  ALV_FILE_INPUT=$1
  ALV_FILE_DIRECTORY=${ALV_FILE_INPUT%/*}
  ALV_FILE_NAME=${ALV_FILE_INPUT##*/}

  if [ "$ALV_FILE_DIRECTORY" = "$ALV_FILE_INPUT" ]; then
    ALV_FILE_DIRECTORY=.
  elif [ -z "$ALV_FILE_DIRECTORY" ]; then
    ALV_FILE_DIRECTORY=/
  fi

  ALV_FILE_DIRECTORY=$(alv_canonical_directory "$ALV_FILE_DIRECTORY")
  printf '%s/%s\n' "$ALV_FILE_DIRECTORY" "$ALV_FILE_NAME"
}

alv_rollout_name() {
  ALV_ROLLOUT_PATH=$1
  ALV_ROLLOUT_NAME=${ALV_ROLLOUT_PATH##*/}

  case "$ALV_ROLLOUT_NAME" in
    rollout-*.jsonl) ;;
    *) alv_fail "expected a Codex rollout-*.jsonl chat: $ALV_ROLLOUT_PATH" ;;
  esac

  case "$ALV_ROLLOUT_NAME" in
    *[!A-Za-z0-9._-]*)
      alv_fail "chat filename contains unsupported characters: $ALV_ROLLOUT_NAME"
      ;;
  esac

  printf '%s\n' "$ALV_ROLLOUT_NAME"
}

alv_require_regular_file() {
  [ -f "$1" ] || alv_fail "file does not exist: $1"
  [ ! -L "$1" ] || alv_fail "symbolic links are not accepted: $1"
}

alv_sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    alv_fail "neither shasum nor sha256sum is available"
  fi
}

alv_file_size() {
  if ALV_SIZE_VALUE=$(stat -f '%z' "$1" 2>/dev/null); then
    case "$ALV_SIZE_VALUE" in
      ''|*[!0-9]*) ;;
      *) printf '%s\n' "$ALV_SIZE_VALUE"; return ;;
    esac
  fi

  if ALV_SIZE_VALUE=$(stat -c '%s' "$1" 2>/dev/null); then
    case "$ALV_SIZE_VALUE" in
      ''|*[!0-9]*) ;;
      *) printf '%s\n' "$ALV_SIZE_VALUE"; return ;;
    esac
  fi

  alv_fail "could not determine file size: $1"
}

alv_copy_verified() {
  ALV_COPY_SOURCE=$1
  ALV_COPY_DESTINATION=$2

  [ ! -e "$ALV_COPY_DESTINATION" ] || \
    alv_fail "refusing to overwrite: $ALV_COPY_DESTINATION"
  [ ! -L "$ALV_COPY_DESTINATION" ] || \
    alv_fail "refusing to overwrite symbolic link: $ALV_COPY_DESTINATION"

  ALV_TEMP_DATA=${ALV_COPY_DESTINATION}.partial.$$
  [ ! -e "$ALV_TEMP_DATA" ] || \
    alv_fail "temporary path already exists: $ALV_TEMP_DATA"

  ALV_SOURCE_HASH_BEFORE=$(alv_sha256_file "$ALV_COPY_SOURCE")
  cp "$ALV_COPY_SOURCE" "$ALV_TEMP_DATA"
  chmod 600 "$ALV_TEMP_DATA"
  ALV_COPIED_HASH=$(alv_sha256_file "$ALV_TEMP_DATA")
  ALV_SOURCE_HASH_AFTER=$(alv_sha256_file "$ALV_COPY_SOURCE")

  [ "$ALV_SOURCE_HASH_BEFORE" = "$ALV_SOURCE_HASH_AFTER" ] || \
    alv_fail "source changed while it was being copied"
  [ "$ALV_SOURCE_HASH_BEFORE" = "$ALV_COPIED_HASH" ] || \
    alv_fail "copied bytes do not match the source"
  [ ! -e "$ALV_COPY_DESTINATION" ] || \
    alv_fail "destination appeared while copying: $ALV_COPY_DESTINATION"

  mv "$ALV_TEMP_DATA" "$ALV_COPY_DESTINATION"
  ALV_TEMP_DATA=
  # Consumed by the sourced rclone storage implementation.
  # shellcheck disable=SC2034
  ALV_COPY_HASH=$ALV_COPIED_HASH
}

alv_default_codex_home() {
  if [ -n "${CODEX_HOME:-}" ]; then
    printf '%s\n' "$CODEX_HOME"
  elif [ -n "${HOME:-}" ]; then
    printf '%s/.codex\n' "$HOME"
  else
    alv_fail "cannot determine Codex home; use --codex-home"
  fi
}

alv_resolve_codex_source() {
  ALV_SOURCE_INPUT=$1
  ALV_SOURCE_HOME_INPUT=$2

  case "$ALV_SOURCE_INPUT" in
    */*)
      ALV_CODEX_SOURCE_FILE=$(alv_canonical_file "$ALV_SOURCE_INPUT")
      alv_require_regular_file "$ALV_CODEX_SOURCE_FILE"
      ALV_CODEX_SOURCE_NAME=$(alv_rollout_name "$ALV_CODEX_SOURCE_FILE")
      ALV_CODEX_SOURCE_DIRECTORY=${ALV_CODEX_SOURCE_FILE%/*}
      [ "${ALV_CODEX_SOURCE_DIRECTORY##*/}" = archived_sessions ] || \
        alv_fail "source must be directly inside a Codex archived_sessions directory"
      ALV_CODEX_SOURCE_HOME=${ALV_CODEX_SOURCE_DIRECTORY%/*}

      if [ -n "$ALV_SOURCE_HOME_INPUT" ]; then
        ALV_EXPECTED_CODEX_HOME_RAW=$ALV_SOURCE_HOME_INPUT
      else
        ALV_EXPECTED_CODEX_HOME_RAW=$(alv_default_codex_home)
      fi
      ALV_EXPECTED_CODEX_HOME=$(alv_canonical_directory \
        "$ALV_EXPECTED_CODEX_HOME_RAW")
      [ "$ALV_EXPECTED_CODEX_HOME" = "$ALV_CODEX_SOURCE_HOME" ] || \
        alv_fail "source is not inside the selected Codex home"
      ;;
    *)
      ALV_CODEX_SOURCE_NAME=$(alv_rollout_name "$ALV_SOURCE_INPUT")
      if [ -n "$ALV_SOURCE_HOME_INPUT" ]; then
        ALV_SOURCE_HOME_RAW=$ALV_SOURCE_HOME_INPUT
      else
        ALV_SOURCE_HOME_RAW=$(alv_default_codex_home)
      fi
      ALV_CODEX_SOURCE_HOME=$(alv_canonical_directory "$ALV_SOURCE_HOME_RAW")
      ALV_CODEX_SOURCE_DIRECTORY=$ALV_CODEX_SOURCE_HOME/archived_sessions
      ALV_CODEX_SOURCE_FILE=$ALV_CODEX_SOURCE_DIRECTORY/$ALV_CODEX_SOURCE_NAME
      alv_require_regular_file "$ALV_CODEX_SOURCE_FILE"
      ;;
  esac
}

alv_prepare_codex_target() {
  ALV_TARGET_HOME_INPUT=$1
  if [ -n "$ALV_TARGET_HOME_INPUT" ]; then
    ALV_TARGET_HOME_RAW=$ALV_TARGET_HOME_INPUT
  else
    ALV_TARGET_HOME_RAW=$(alv_default_codex_home)
  fi

  ALV_CODEX_TARGET_HOME=$(alv_canonical_directory "$ALV_TARGET_HOME_RAW")
  ALV_CODEX_TARGET_ARCHIVED=$ALV_CODEX_TARGET_HOME/archived_sessions
  [ ! -L "$ALV_CODEX_TARGET_ARCHIVED" ] || \
    alv_fail "target archived_sessions path is a symbolic link"
  mkdir -p "$ALV_CODEX_TARGET_ARCHIVED"
  ALV_CODEX_TARGET_ARCHIVED=$(alv_canonical_directory "$ALV_CODEX_TARGET_ARCHIVED")

  case "$ALV_CODEX_TARGET_ARCHIVED" in
    "$ALV_CODEX_TARGET_HOME"/*) ;;
    *) alv_fail "target archived_sessions directory escapes the Codex home" ;;
  esac
}

alv_list_codex() {
  ALV_LIST_HOME_RAW=$1
  if [ -z "$ALV_LIST_HOME_RAW" ]; then
    ALV_LIST_HOME_RAW=$(alv_default_codex_home)
  fi
  ALV_LIST_HOME=$(alv_canonical_directory "$ALV_LIST_HOME_RAW")
  ALV_LIST_ARCHIVED=$ALV_LIST_HOME/archived_sessions

  [ ! -L "$ALV_LIST_ARCHIVED" ] || \
    alv_fail "Codex archived_sessions path is a symbolic link"
  [ -d "$ALV_LIST_ARCHIVED" ] || return 0

  for ALV_LIST_FILE in "$ALV_LIST_ARCHIVED"/rollout-*.jsonl; do
    [ -e "$ALV_LIST_FILE" ] || continue
    alv_require_regular_file "$ALV_LIST_FILE"
    alv_rollout_name "$ALV_LIST_FILE"
  done
}

ALV_SCRIPT_PATH=$0
case "$ALV_SCRIPT_PATH" in
  */*) ;;
  *) ALV_SCRIPT_PATH=$(command -v "$ALV_SCRIPT_PATH") || alv_fail "cannot locate executable" ;;
esac
while [ -L "$ALV_SCRIPT_PATH" ]; do
  ALV_SCRIPT_LINK_DIRECTORY=$(CDPATH='' cd -P "$(dirname "$ALV_SCRIPT_PATH")" 2>/dev/null && pwd -P) || \
    alv_fail "cannot resolve executable symlink directory"
  ALV_SCRIPT_LINK_TARGET=$(readlink "$ALV_SCRIPT_PATH") || \
    alv_fail "cannot resolve executable symlink"
  case "$ALV_SCRIPT_LINK_TARGET" in
    /*) ALV_SCRIPT_PATH=$ALV_SCRIPT_LINK_TARGET ;;
    *) ALV_SCRIPT_PATH=$ALV_SCRIPT_LINK_DIRECTORY/$ALV_SCRIPT_LINK_TARGET ;;
  esac
done
ALV_SCRIPT_DIRECTORY=$(CDPATH='' cd -P "$(dirname "$ALV_SCRIPT_PATH")" 2>/dev/null && pwd -P) || \
  alv_fail "cannot locate library directory"
ALV_LIBRARY_DIRECTORY=${AGENT_LOG_VAULT_LIB_DIR:-$ALV_SCRIPT_DIRECTORY/lib/agent-log-vault}

[ -r "$ALV_LIBRARY_DIRECTORY/rclone-storage.sh" ] || \
  alv_fail "missing rclone storage implementation: $ALV_LIBRARY_DIRECTORY/rclone-storage.sh"
[ -r "$ALV_LIBRARY_DIRECTORY/catalog.sh" ] || \
  alv_fail "missing catalog support: $ALV_LIBRARY_DIRECTORY/catalog.sh"
[ -r "$ALV_LIBRARY_DIRECTORY/profiles.sh" ] || \
  alv_fail "missing vault profiles: $ALV_LIBRARY_DIRECTORY/profiles.sh"
[ -r "$ALV_LIBRARY_DIRECTORY/storage.sh" ] || \
  alv_fail "missing storage dispatcher: $ALV_LIBRARY_DIRECTORY/storage.sh"
[ -r "$ALV_LIBRARY_DIRECTORY/vaults.sh" ] || \
  alv_fail "missing vault setup support: $ALV_LIBRARY_DIRECTORY/vaults.sh"

. "$ALV_LIBRARY_DIRECTORY/rclone-storage.sh"
. "$ALV_LIBRARY_DIRECTORY/catalog.sh"
. "$ALV_LIBRARY_DIRECTORY/profiles.sh"
. "$ALV_LIBRARY_DIRECTORY/storage.sh"
. "$ALV_LIBRARY_DIRECTORY/vaults.sh"

alv_command_list() {
  [ "$#" -gt 0 ] || alv_fail "list requires local or cold"
  ALV_LIST_SIDE=$1
  shift

  ALV_LIST_CODEX_HOME=
  ALV_LIST_VAULT=
  ALV_LIST_LONG=false
  ALV_LIST_CREATED_BEFORE=
  ALV_LIST_CREATED_AFTER=
  ALV_LIST_PROJECT=
  ALV_LIST_LARGER_THAN=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --codex-home)
        [ "$#" -ge 2 ] || alv_fail "--codex-home requires a directory"
        [ -z "$ALV_LIST_CODEX_HOME" ] || alv_fail "--codex-home was provided more than once"
        ALV_LIST_CODEX_HOME=$2
        shift 2
        ;;
      --vault)
        [ "$#" -ge 2 ] || alv_fail "--vault requires a name"
        [ -z "$ALV_LIST_VAULT" ] || alv_fail "--vault was provided more than once"
        ALV_LIST_VAULT=$2
        shift 2
        ;;
      --long)
        ALV_LIST_LONG=true
        shift
        ;;
      --created-before)
        [ "$#" -ge 2 ] || alv_fail "--created-before requires YYYY-MM-DD"
        [ -z "$ALV_LIST_CREATED_BEFORE" ] || \
          alv_fail "--created-before was provided more than once"
        ALV_LIST_CREATED_BEFORE=$2
        shift 2
        ;;
      --created-after)
        [ "$#" -ge 2 ] || alv_fail "--created-after requires YYYY-MM-DD"
        [ -z "$ALV_LIST_CREATED_AFTER" ] || \
          alv_fail "--created-after was provided more than once"
        ALV_LIST_CREATED_AFTER=$2
        shift 2
        ;;
      --project)
        [ "$#" -ge 2 ] || alv_fail "--project requires a cwd or directory name"
        [ -z "$ALV_LIST_PROJECT" ] || alv_fail "--project was provided more than once"
        ALV_LIST_PROJECT=$2
        shift 2
        ;;
      --larger-than)
        [ "$#" -ge 2 ] || alv_fail "--larger-than requires a size"
        [ -z "$ALV_LIST_LARGER_THAN" ] || \
          alv_fail "--larger-than was provided more than once"
        ALV_LIST_LARGER_THAN=$2
        shift 2
        ;;
      *) alv_fail "unknown list option: $1" ;;
    esac
  done

  case "$ALV_LIST_SIDE" in
    local)
      [ -z "$ALV_LIST_VAULT" ] || \
        alv_fail "--vault is only valid when listing cold"
      if [ "$ALV_LIST_LONG" = true ] || \
         [ -n "$ALV_LIST_CREATED_BEFORE" ] || \
         [ -n "$ALV_LIST_CREATED_AFTER" ] || \
         [ -n "$ALV_LIST_PROJECT" ] || \
         [ -n "$ALV_LIST_LARGER_THAN" ]; then
        alv_catalog_list_codex \
          "$ALV_LIST_CODEX_HOME" \
          "$ALV_LIST_LONG" \
          "$ALV_LIST_CREATED_BEFORE" \
          "$ALV_LIST_CREATED_AFTER" \
          "$ALV_LIST_PROJECT" \
          "$ALV_LIST_LARGER_THAN"
      else
        alv_list_codex "$ALV_LIST_CODEX_HOME"
      fi
      ;;
    cold)
      [ -z "$ALV_LIST_CODEX_HOME" ] || \
        alv_fail "--codex-home is only valid when listing local"
      if [ "$ALV_LIST_LONG" != false ] || \
         [ -n "$ALV_LIST_CREATED_BEFORE" ] || \
         [ -n "$ALV_LIST_CREATED_AFTER" ] || \
         [ -n "$ALV_LIST_PROJECT" ] || \
         [ -n "$ALV_LIST_LARGER_THAN" ]; then
        alv_fail "metadata filters are only valid when listing local"
      fi
      alv_profile_load_selected "$ALV_LIST_VAULT"
      alv_storage_open "$ALV_PROFILE_LOCATION"
      alv_storage_list
      ;;
    *) alv_fail "list requires local or cold" ;;
  esac
}

alv_command_inspect() {
  [ "$#" -gt 0 ] || alv_fail "inspect requires a chat"
  ALV_INSPECT_CHAT=$1
  shift

  ALV_INSPECT_CODEX_HOME=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --codex-home)
        [ "$#" -ge 2 ] || alv_fail "--codex-home requires a directory"
        [ -z "$ALV_INSPECT_CODEX_HOME" ] || \
          alv_fail "--codex-home was provided more than once"
        ALV_INSPECT_CODEX_HOME=$2
        shift 2
        ;;
      *) alv_fail "unknown inspect option: $1" ;;
    esac
  done

  alv_resolve_codex_source "$ALV_INSPECT_CHAT" "$ALV_INSPECT_CODEX_HOME"
  alv_catalog_inspect \
    "$ALV_CODEX_SOURCE_FILE" \
    "$ALV_CODEX_SOURCE_NAME" \
    "$ALV_CODEX_SOURCE_HOME"
}

alv_command_offload() {
  [ "$#" -gt 0 ] || alv_fail "offload requires a thread"
  ALV_OFFLOAD_CHAT=$1
  shift

  ALV_OFFLOAD_VAULT=
  ALV_OFFLOAD_CODEX_HOME=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --vault)
        [ "$#" -ge 2 ] || alv_fail "--vault requires a name"
        [ -z "$ALV_OFFLOAD_VAULT" ] || \
          alv_fail "--vault was provided more than once"
        ALV_OFFLOAD_VAULT=$2
        shift 2
        ;;
      --codex-home)
        [ "$#" -ge 2 ] || alv_fail "--codex-home requires a directory"
        [ -z "$ALV_OFFLOAD_CODEX_HOME" ] || \
          alv_fail "--codex-home was provided more than once"
        ALV_OFFLOAD_CODEX_HOME=$2
        shift 2
        ;;
      *) alv_fail "unknown offload option: $1" ;;
    esac
  done

  alv_resolve_codex_source "$ALV_OFFLOAD_CHAT" "$ALV_OFFLOAD_CODEX_HOME"
  alv_profile_load_selected "$ALV_OFFLOAD_VAULT"
  alv_storage_open "$ALV_PROFILE_LOCATION"
  alv_storage_assert_external_to "$ALV_CODEX_SOURCE_HOME"

  ALV_OFFLOAD_HASH_BEFORE=$(alv_sha256_file "$ALV_CODEX_SOURCE_FILE")
  alv_storage_has "$ALV_CODEX_SOURCE_NAME"
  if [ "$ALV_STORAGE_PRESENT" = true ]; then
    alv_storage_verify "$ALV_CODEX_SOURCE_NAME"
    [ "$ALV_OFFLOAD_HASH_BEFORE" = "$ALV_STORAGE_HASH" ] || \
      alv_fail "cold thread does not match the local archived thread"
    ALV_OFFLOAD_REUSED=true
  else
    alv_storage_put "$ALV_CODEX_SOURCE_FILE" "$ALV_CODEX_SOURCE_NAME"
    [ "$ALV_OFFLOAD_HASH_BEFORE" = "$ALV_STORAGE_HASH" ] || \
      alv_fail "verified cold thread does not match the local archived thread"
    ALV_OFFLOAD_REUSED=false
  fi

  ALV_OFFLOAD_HASH_AFTER=$(alv_sha256_file "$ALV_CODEX_SOURCE_FILE")
  [ "$ALV_OFFLOAD_HASH_BEFORE" = "$ALV_OFFLOAD_HASH_AFTER" ] || \
    alv_fail "local archived thread changed while it was being offloaded"
  unlink "$ALV_CODEX_SOURCE_FILE"
  [ ! -e "$ALV_CODEX_SOURCE_FILE" ] || \
    alv_fail "failed to remove local archived thread"

  if [ "$ALV_OFFLOAD_REUSED" = true ]; then
    printf 'verified existing cold copy; removed local %s\n' "$ALV_CODEX_SOURCE_NAME"
  else
    printf 'offloaded %s to vault %s; removed local copy\n' \
      "$ALV_CODEX_SOURCE_NAME" "$ALV_PROFILE_NAME"
  fi
  printf 'sha256 %s\n' "$ALV_STORAGE_HASH"
}

alv_command_verify() {
  [ "$#" -gt 0 ] || alv_fail "verify requires a thread"
  ALV_VERIFY_NAME=$(alv_rollout_name "$1")
  shift

  ALV_VERIFY_VAULT=
  ALV_VERIFY_CODEX_HOME=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --vault)
        [ "$#" -ge 2 ] || alv_fail "--vault requires a name"
        [ -z "$ALV_VERIFY_VAULT" ] || alv_fail "--vault was provided more than once"
        ALV_VERIFY_VAULT=$2
        shift 2
        ;;
      --codex-home)
        [ "$#" -ge 2 ] || alv_fail "--codex-home requires a directory"
        [ -z "$ALV_VERIFY_CODEX_HOME" ] || \
          alv_fail "--codex-home was provided more than once"
        ALV_VERIFY_CODEX_HOME=$2
        shift 2
        ;;
      *) alv_fail "unknown verify option: $1" ;;
    esac
  done

  alv_profile_load_selected "$ALV_VERIFY_VAULT"
  alv_storage_open "$ALV_PROFILE_LOCATION"
  alv_storage_verify "$ALV_VERIFY_NAME"

  ALV_VERIFY_STATE=cold-only
  ALV_VERIFY_HOME=
  if [ -n "$ALV_VERIFY_CODEX_HOME" ]; then
    ALV_VERIFY_HOME=$(alv_canonical_directory "$ALV_VERIFY_CODEX_HOME")
  else
    ALV_VERIFY_HOME_RAW=$(alv_default_codex_home)
    if [ -d "$ALV_VERIFY_HOME_RAW" ] && [ ! -L "$ALV_VERIFY_HOME_RAW" ]; then
      ALV_VERIFY_HOME=$(alv_canonical_directory "$ALV_VERIFY_HOME_RAW")
    elif [ -e "$ALV_VERIFY_HOME_RAW" ] || [ -L "$ALV_VERIFY_HOME_RAW" ]; then
      alv_fail "Codex home is not a regular directory: $ALV_VERIFY_HOME_RAW"
    fi
  fi

  if [ -n "$ALV_VERIFY_HOME" ]; then
    ALV_VERIFY_ARCHIVED=$ALV_VERIFY_HOME/archived_sessions
    [ ! -L "$ALV_VERIFY_ARCHIVED" ] || \
      alv_fail "Codex archived_sessions path is a symbolic link"
    ALV_VERIFY_LOCAL=$ALV_VERIFY_ARCHIVED/$ALV_VERIFY_NAME
    if [ -e "$ALV_VERIFY_LOCAL" ] || [ -L "$ALV_VERIFY_LOCAL" ]; then
      alv_require_regular_file "$ALV_VERIFY_LOCAL"
      ALV_VERIFY_LOCAL_HASH=$(alv_sha256_file "$ALV_VERIFY_LOCAL")
      [ "$ALV_VERIFY_LOCAL_HASH" = "$ALV_STORAGE_HASH" ] || \
        alv_fail "cold thread differs from the local archived thread"
      ALV_VERIFY_STATE=both
    fi
  fi

  printf 'verified %s in vault %s (%s bytes, %s)\n' \
    "$ALV_VERIFY_NAME" "$ALV_PROFILE_NAME" "$ALV_STORAGE_SIZE" "$ALV_VERIFY_STATE"
  printf 'sha256 %s\n' "$ALV_STORAGE_HASH"
}

alv_command_restore() {
  [ "$#" -gt 0 ] || alv_fail "restore requires a thread"
  ALV_RESTORE_NAME=$(alv_rollout_name "$1")
  shift

  ALV_RESTORE_VAULT=
  ALV_RESTORE_CODEX_HOME=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --vault)
        [ "$#" -ge 2 ] || alv_fail "--vault requires a name"
        [ -z "$ALV_RESTORE_VAULT" ] || \
          alv_fail "--vault was provided more than once"
        ALV_RESTORE_VAULT=$2
        shift 2
        ;;
      --codex-home)
        [ "$#" -ge 2 ] || alv_fail "--codex-home requires a directory"
        [ -z "$ALV_RESTORE_CODEX_HOME" ] || alv_fail "--codex-home was provided more than once"
        ALV_RESTORE_CODEX_HOME=$2
        shift 2
        ;;
      *) alv_fail "unknown restore option: $1" ;;
    esac
  done

  alv_profile_load_selected "$ALV_RESTORE_VAULT"
  alv_storage_open "$ALV_PROFILE_LOCATION"
  if [ -n "$ALV_RESTORE_CODEX_HOME" ]; then
    ALV_RESTORE_TARGET_HOME=$(alv_canonical_directory "$ALV_RESTORE_CODEX_HOME")
  else
    ALV_RESTORE_TARGET_HOME=$(alv_canonical_directory "$(alv_default_codex_home)")
  fi
  alv_storage_assert_external_to "$ALV_RESTORE_TARGET_HOME"
  alv_prepare_codex_target "$ALV_RESTORE_TARGET_HOME"
  ALV_RESTORE_DESTINATION=$ALV_CODEX_TARGET_ARCHIVED/$ALV_RESTORE_NAME
  if [ -e "$ALV_RESTORE_DESTINATION" ] || [ -L "$ALV_RESTORE_DESTINATION" ]; then
    alv_require_regular_file "$ALV_RESTORE_DESTINATION"
    ALV_RESTORE_LOCAL_HASH=$(alv_sha256_file "$ALV_RESTORE_DESTINATION")
    alv_storage_verify "$ALV_RESTORE_NAME"
    [ "$ALV_RESTORE_LOCAL_HASH" = "$ALV_STORAGE_HASH" ] || \
      alv_fail "refusing to overwrite a different local archived thread"
    printf 'already restored %s; cold copy retained in vault %s\n' \
      "$ALV_RESTORE_NAME" "$ALV_PROFILE_NAME"
  else
    alv_storage_get "$ALV_RESTORE_NAME" "$ALV_RESTORE_DESTINATION"
    printf 'restored %s; cold copy retained in vault %s\n' \
      "$ALV_RESTORE_DESTINATION" "$ALV_PROFILE_NAME"
  fi

  printf 'sha256 %s\n' "$ALV_STORAGE_HASH"
}

alv_command_vault_add() {
  [ "$#" -ge 2 ] || alv_fail "vault add requires a provider and name"
  ALV_VAULT_ADD_PROVIDER=$1
  ALV_VAULT_ADD_NAME=$2
  shift 2

  ALV_VAULT_ADD_PATH=
  ALV_VAULT_ADD_REMOTE=
  ALV_VAULT_ADD_ACCOUNT=
  ALV_VAULT_ADD_ACCESS=
  ALV_VAULT_ADD_SECRET=
  ALV_VAULT_ADD_BUCKET=
  ALV_VAULT_ADD_ENDPOINT=
  ALV_VAULT_ADD_ACCOUNT_OPTION=
  ALV_VAULT_ADD_SECRET_OPTION=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --path)
        [ "$#" -ge 2 ] || alv_fail "--path requires a directory"
        [ -z "$ALV_VAULT_ADD_PATH" ] || alv_fail "--path was provided more than once"
        ALV_VAULT_ADD_PATH=$2
        shift 2
        ;;
      --remote)
        [ "$#" -ge 2 ] || alv_fail "--remote requires an rclone target"
        [ -z "$ALV_VAULT_ADD_REMOTE" ] || alv_fail "--remote was provided more than once"
        ALV_VAULT_ADD_REMOTE=$2
        shift 2
        ;;
      --account-id|--key-id)
        [ "$#" -ge 2 ] || alv_fail "$1 requires a value"
        [ -z "$ALV_VAULT_ADD_ACCOUNT" ] || alv_fail "account/key ID was provided more than once"
        ALV_VAULT_ADD_ACCOUNT_OPTION=$1
        ALV_VAULT_ADD_ACCOUNT=$2
        shift 2
        ;;
      --access-key-id)
        [ "$#" -ge 2 ] || alv_fail "--access-key-id requires a value"
        [ -z "$ALV_VAULT_ADD_ACCESS" ] || \
          alv_fail "--access-key-id was provided more than once"
        ALV_VAULT_ADD_ACCESS=$2
        shift 2
        ;;
      --secret-access-key|--application-key)
        [ "$#" -ge 2 ] || alv_fail "$1 requires a value"
        [ -z "$ALV_VAULT_ADD_SECRET" ] || alv_fail "provider secret was provided more than once"
        ALV_VAULT_ADD_SECRET_OPTION=$1
        ALV_VAULT_ADD_SECRET=$2
        shift 2
        ;;
      --bucket)
        [ "$#" -ge 2 ] || alv_fail "--bucket requires a name"
        [ -z "$ALV_VAULT_ADD_BUCKET" ] || alv_fail "--bucket was provided more than once"
        ALV_VAULT_ADD_BUCKET=$2
        shift 2
        ;;
      --endpoint)
        [ "$#" -ge 2 ] || alv_fail "--endpoint requires a URL"
        [ -z "$ALV_VAULT_ADD_ENDPOINT" ] || \
          alv_fail "--endpoint was provided more than once"
        ALV_VAULT_ADD_ENDPOINT=$2
        shift 2
        ;;
      *) alv_fail "unknown vault add option: $1" ;;
    esac
  done

  case "$ALV_VAULT_ADD_PROVIDER" in
    local)
      [ -n "$ALV_VAULT_ADD_PATH" ] || alv_fail "local vault requires --path"
      [ -z "$ALV_VAULT_ADD_REMOTE$ALV_VAULT_ADD_ACCOUNT$ALV_VAULT_ADD_ACCESS$ALV_VAULT_ADD_SECRET$ALV_VAULT_ADD_BUCKET$ALV_VAULT_ADD_ENDPOINT" ] || \
        alv_fail "local vault accepts only --path"
      alv_vault_add_local "$ALV_VAULT_ADD_NAME" "$ALV_VAULT_ADD_PATH"
      ;;
    r2)
      [ -z "$ALV_VAULT_ADD_PATH$ALV_VAULT_ADD_REMOTE" ] || \
        alv_fail "R2 vault does not accept --path or --remote"
      case "$ALV_VAULT_ADD_ACCOUNT_OPTION" in
        ''|--account-id) ;;
        *) alv_fail "R2 vault accepts --account-id, not $ALV_VAULT_ADD_ACCOUNT_OPTION" ;;
      esac
      case "$ALV_VAULT_ADD_SECRET_OPTION" in
        ''|--secret-access-key) ;;
        *) alv_fail "R2 vault accepts --secret-access-key, not $ALV_VAULT_ADD_SECRET_OPTION" ;;
      esac
      alv_vault_add_r2 \
        "$ALV_VAULT_ADD_NAME" \
        "$ALV_VAULT_ADD_ACCOUNT" \
        "$ALV_VAULT_ADD_ACCESS" \
        "$ALV_VAULT_ADD_SECRET" \
        "$ALV_VAULT_ADD_BUCKET" \
        "$ALV_VAULT_ADD_ENDPOINT"
      ;;
    b2)
      [ -z "$ALV_VAULT_ADD_PATH$ALV_VAULT_ADD_REMOTE$ALV_VAULT_ADD_ACCESS" ] || \
        alv_fail "B2 vault does not accept --path, --remote, or --access-key-id"
      case "$ALV_VAULT_ADD_ACCOUNT_OPTION" in
        ''|--key-id) ;;
        *) alv_fail "B2 vault accepts --key-id, not $ALV_VAULT_ADD_ACCOUNT_OPTION" ;;
      esac
      case "$ALV_VAULT_ADD_SECRET_OPTION" in
        ''|--application-key) ;;
        *) alv_fail "B2 vault accepts --application-key, not $ALV_VAULT_ADD_SECRET_OPTION" ;;
      esac
      alv_vault_add_b2 \
        "$ALV_VAULT_ADD_NAME" \
        "$ALV_VAULT_ADD_ACCOUNT" \
        "$ALV_VAULT_ADD_SECRET" \
        "$ALV_VAULT_ADD_BUCKET" \
        "$ALV_VAULT_ADD_ENDPOINT"
      ;;
    dropbox|onedrive)
      [ -z "$ALV_VAULT_ADD_PATH$ALV_VAULT_ADD_REMOTE$ALV_VAULT_ADD_ACCOUNT$ALV_VAULT_ADD_ACCESS$ALV_VAULT_ADD_SECRET$ALV_VAULT_ADD_BUCKET$ALV_VAULT_ADD_ENDPOINT" ] || \
        alv_fail "$ALV_VAULT_ADD_PROVIDER vault does not accept provider options"
      if [ "$ALV_VAULT_ADD_PROVIDER" = dropbox ]; then
        alv_vault_add_dropbox "$ALV_VAULT_ADD_NAME"
      else
        alv_vault_add_onedrive "$ALV_VAULT_ADD_NAME"
      fi
      ;;
    rclone)
      [ -n "$ALV_VAULT_ADD_REMOTE" ] || alv_fail "rclone vault requires --remote"
      [ -z "$ALV_VAULT_ADD_PATH$ALV_VAULT_ADD_ACCOUNT$ALV_VAULT_ADD_ACCESS$ALV_VAULT_ADD_SECRET$ALV_VAULT_ADD_BUCKET$ALV_VAULT_ADD_ENDPOINT" ] || \
        alv_fail "rclone vault accepts only --remote"
      alv_vault_add_rclone "$ALV_VAULT_ADD_NAME" "$ALV_VAULT_ADD_REMOTE"
      ;;
    *) alv_fail "unsupported vault provider: $ALV_VAULT_ADD_PROVIDER" ;;
  esac

  printf 'configured encrypted %s vault %s\n' \
    "$ALV_VAULT_ADD_PROVIDER" "$ALV_VAULT_ADD_NAME"
}

alv_command_vault() {
  [ "$#" -gt 0 ] || alv_fail "vault requires add, list, use, or recovery"
  ALV_VAULT_COMMAND=$1
  shift

  case "$ALV_VAULT_COMMAND" in
    add) alv_command_vault_add "$@" ;;
    list)
      [ "$#" -eq 0 ] || alv_fail "vault list accepts no options"
      alv_profile_list
      ;;
    use)
      [ "$#" -eq 1 ] || alv_fail "vault use requires one name"
      alv_profile_use "$1"
      printf 'default vault is now %s\n' "$1"
      ;;
    recovery)
      [ "$#" -gt 0 ] || alv_fail "vault recovery requires a name"
      ALV_VAULT_RECOVERY_NAME=$1
      shift
      ALV_VAULT_RECOVERY_OUTPUT=
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --output)
            [ "$#" -ge 2 ] || alv_fail "--output requires a file"
            [ -z "$ALV_VAULT_RECOVERY_OUTPUT" ] || \
              alv_fail "--output was provided more than once"
            ALV_VAULT_RECOVERY_OUTPUT=$2
            shift 2
            ;;
          *) alv_fail "unknown vault recovery option: $1" ;;
        esac
      done
      [ -n "$ALV_VAULT_RECOVERY_OUTPUT" ] || \
        alv_fail "vault recovery requires --output <file>"
      alv_vault_export_recovery \
        "$ALV_VAULT_RECOVERY_NAME" "$ALV_VAULT_RECOVERY_OUTPUT"
      ;;
    *) alv_fail "unknown vault command: $ALV_VAULT_COMMAND" ;;
  esac
}

[ "$#" -gt 0 ] || {
  alv_usage >&2
  exit 2
}

ALV_COMMAND=$1
shift

case "$ALV_COMMAND" in
  list) alv_command_list "$@" ;;
  offload) alv_command_offload "$@" ;;
  restore) alv_command_restore "$@" ;;
  verify) alv_command_verify "$@" ;;
  inspect) alv_command_inspect "$@" ;;
  vault) alv_command_vault "$@" ;;
  help|-h|--help) alv_usage ;;
  *)
    alv_usage >&2
    alv_fail "unknown command: $ALV_COMMAND"
    ;;
esac
